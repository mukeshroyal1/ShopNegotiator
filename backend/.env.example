DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Prefer Session pooler (IPv4). Encode password special chars.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=write_draft_orders,write_inventory,read_inventory,read_locations,read_orders,write_orders,read_products,write_products
SHOPIFY_API_VERSION=2024-10
SHOPIFY_REDIRECT_URI=http://localhost:8000/api/shopify/callback/
# Public HTTPS origin of this API (Render URL or ngrok). Required for live Shopify webhooks.
SHOPIFY_APP_URL=

# LangGraph agent (Milestone 2). Run `cd agent && uvicorn app.main:app --port 8080`
AGENT_SERVICE_URL=http://127.0.0.1:8080
AGENT_SERVICE_SECRET=dev-agent-secret-change-me

# Twilio Voice (Milestone 3). Webhooks need a public HTTPS base (ngrok / deployed API).
# Host from TWILIO_WEBHOOK_BASE_URL is auto-added to ALLOWED_HOSTS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_BASE_URL=https://YOUR-NGROK.ngrok-free.app
# Optional; defaults to AGENT_SERVICE_SECRET (?token= on voice/gather/status URLs)
TWILIO_WEBHOOK_SECRET=
